{
  "name": "backtesting-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven backtesting engine with deterministic, verifiable results",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "data:download": "node scripts/download-klines.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
