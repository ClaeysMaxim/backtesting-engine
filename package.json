{
  "name": "backtesting-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven backtesting engine with deterministic, verifiable results",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
